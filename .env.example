# =========================================================================
# Software Factory — environment template. Copy to .env and fill in.
# NEVER commit real secrets. All secrets are injected via env vars only.
#
# docker compose reads .env from the repo root automatically; this file
# covers EVERY service in docker-compose.yml:
#   postgres, redis, backend (:8080), frontend store (:3000),
#   platform API (:5090), factory dashboard (:3001)
#
# Deploying outside Development? Read docs/DEPLOYMENT.md first — the
# backend REFUSES TO BOOT without Jwt__Key (32+ bytes) / Jwt__Issuer /
# Jwt__Audience, the frontend needs BACKEND_JWT_KEY == Jwt__Key, and the
# seed SKIPS accounts without explicit passwords (matrix + CI secrets
# checklist in that runbook).
# =========================================================================

# ---------- Shared ----------
COMPOSE_PROJECT_NAME=software-factory
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development

# ---------- PostgreSQL (shared by backend, Payload and the platform) ----------
POSTGRES_USER=factory
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=factory
POSTGRES_PORT=5432
# Connection string consumed by the .NET API
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=factory;Username=factory;Password=change_me_in_prod
# Connection string consumed by Payload / Next.js
DATABASE_URI=postgres://factory:change_me_in_prod@postgres:5432/factory

# ---------- Redis ----------
REDIS_PORT=6379
ConnectionStrings__Redis=redis:6379
REDIS_URL=redis://redis:6379

# ---------- Backend API (client product API → http://localhost:8080) ----------
API_HTTP_PORT=8080
# CORS origin(s) allowed to call the API
Cors__AllowedOrigins=http://localhost:3000
# Public rate limit (requests per window) for anonymous endpoints
RateLimiting__PermitPerWindow=100
RateLimiting__WindowSeconds=60

# ---------- Frontend / Next.js store (→ http://localhost:3000) ----------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Auth.js (NextAuth) — client storefront ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=change_me_generate_a_32_byte_secret
AUTH_TRUST_HOST=true

# ---------- Backend bearer JWT (Phase 4 client dashboard) ----------
# MUST be the same 32+ byte value on both sides: the frontend signs the
# short-lived staff bearer with BACKEND_JWT_KEY, the backend validates with
# Jwt__Key. FAIL-CLOSED policy (security audit fix #1):
#  - Backend outside Development REFUSES TO BOOT unless Jwt__Key,
#    Jwt__Issuer and Jwt__Audience are set to real, non-dev-constant values.
#  - Frontend under NODE_ENV=production (incl. `next start` in the compose
#    stack) refuses to mint bearers without BACKEND_JWT_KEY — so set the pair
#    below to USE THE DASHBOARD against docker compose.
#  - Only `next dev` + backend Development may fall back to the shared
#    dev-only constants.
# Generate with: openssl rand -base64 32
Jwt__Key=
BACKEND_JWT_KEY=
# Issuer/audience — REQUIRED outside Development, set on both sides.
Jwt__Issuer=
BACKEND_JWT_ISSUER=
Jwt__Audience=
BACKEND_JWT_AUDIENCE=

# ---------- Payload CMS ----------
PAYLOAD_SECRET=change_me_generate_a_long_random_string
# Bootstrap users created by `npm run payload:seed` (see src/payload/seed.ts):
# the factory admin and — when features.clientDashboard is on — the store owner.
# Passwords are NEVER defaulted (security audit fix #2): leave one unset and
# the seed SKIPS that account with a loud log. Pick real values per stack.
PAYLOAD_ADMIN_EMAIL=admin@softwarefactory.local
PAYLOAD_ADMIN_PASSWORD=
DASHBOARD_OWNER_EMAIL=owner@softwarefactory.local
DASHBOARD_OWNER_PASSWORD=

# ---------- Platform API (factory control plane → http://localhost:5090) ----------
PLATFORM_HTTP_PORT=5090
# Dedicated database on the SAME postgres service, kept separate from the
# client product's `factory` DB. The platform applies its EF migrations on
# startup and creates this database if it does not exist yet.
PLATFORM_POSTGRES_DB=factory_platform
# Demo data so the factory dashboard isn't empty on a fresh stack: seeds
# 1 demo client + 1 demo ecommerce project (phase: intake). Idempotent —
# safe across restarts. Anything but "true" (the compose default) skips it.
# Set to false once you track real clients: while true, deleting the demo
# client only lasts until the next platform start.
SEED_DEMO=true
# Manual (non-compose) runs of the platform read this directly:
# PLATFORM_DB_CONNECTION=Host=localhost;Port=5432;Database=factory_platform;Username=factory;Password=change_me_in_prod

# ---------- Factory Dashboard (internal admin → http://localhost:3001) ----------
# NOTE: this is the INTERNAL operator dashboard (apps/factory-dashboard),
# NOT the store's client-facing /dashboard (that one uses the Payload
# DASHBOARD_OWNER_* pair above).
DASHBOARD_PORT=3001
# Signs the dashboard's Auth.js session cookie. REQUIRED — with it unset the
# dashboard errors on every request (fails closed) instead of accepting
# cookies signed with a repo-known value. Generate: openssl rand -base64 32
DASHBOARD_AUTH_SECRET=
# The single operator's sign-in credentials (checked against env directly —
# no user store). The password is NEVER defaulted (same policy as the Payload
# accounts above): leave it unset and sign-in fails closed.
DASHBOARD_ADMIN_EMAIL=admin@softwarefactory.local
DASHBOARD_ADMIN_PASSWORD=
# Shared secret CI sends in the X-Webhook-Secret header to POST /api/webhooks/ci.
DASHBOARD_CI_WEBHOOK_SECRET=change_me_ci_webhook_secret

# ---------- Payments (server-side keys only) ----------
TAMARA_API_KEY=
TAMARA_API_URL=https://api-sandbox.tamara.co
TABI_API_KEY=
TABI_API_URL=https://api.sandbox.tabby.ai

# ---------- Integrations ----------
ZATCA_API_URL=
ZATCA_CERT=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
