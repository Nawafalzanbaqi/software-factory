# ---------------------------------------------------------------------------
# Factory Dashboard (Phase 3) — environment variables
# Copy to .env.local for local dev. Secrets are read server-side only.
# ---------------------------------------------------------------------------

# Auth.js (NextAuth v5). AUTH_SECRET signs the JWT session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-please-32chars-min
AUTH_TRUST_HOST=true

# Single admin credentials (admin-only app). Sign-in checks these directly.
ADMIN_EMAIL=admin@softwarefactory.local
ADMIN_PASSWORD=change-me

# Server-side Platform API base URL (SoftwareFactory.Platform.Api).
PLATFORM_API_BASE_URL=http://localhost:5090

# Shared secret GitHub Actions sends as the X-Webhook-Secret header to
# POST /api/webhooks/ci. Must match the CI workflow secret.
CI_WEBHOOK_SECRET=dev-ci-webhook-secret-change-me
