# Frontend-only env template. The ROOT .env.example is the source of truth for
# shared/stack secrets; this file documents the vars the Next.js app reads.
# Copy relevant values into the root .env (never commit real secrets).

# Public base URL of the .NET backend API (client + server fetches append /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
# Public site origin, used for canonical URLs, hreflang, sitemap, OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET=change_me_generate_a_32_byte_secret
AUTH_TRUST_HOST=true

# --- Client dashboard (Phase 4, features.clientDashboard) --------------------
# Signs the short-lived staff bearer for /api/v1/manage/* — MUST equal the
# backend's Jwt__Key (32+ bytes). FAIL-CLOSED (security audit fix #1): under
# NODE_ENV=production minting THROWS when unset; the dev-only fallback applies
# to `next dev` only. The backend refuses to boot outside Development without
# real Jwt__Key/Jwt__Issuer/Jwt__Audience values.
BACKEND_JWT_KEY=
# Required outside Development; set together with Jwt__Issuer / Jwt__Audience.
BACKEND_JWT_ISSUER=
BACKEND_JWT_AUDIENCE=
# Owner account seeded by `npm run payload:seed` when clientDashboard is on.
# Password is NEVER defaulted (audit fix #2) — unset ⇒ the seed skips the
# account with a loud log.
DASHBOARD_OWNER_EMAIL=owner@softwarefactory.local
DASHBOARD_OWNER_PASSWORD=

# --- Payload CMS 3 (features.cms) -------------------------------------------
# Postgres connection string for the Payload admin + content DB (shared stack DB).
DATABASE_URI=postgres://postgres:postgres@localhost:5432/software_factory
# Payload encryption/JWT secret. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change_me_generate_a_32_byte_secret
# Bootstrap admin credentials used by src/payload/seed.ts on first run.
# Password is NEVER defaulted (audit fix #2) — unset ⇒ the seed skips the
# account with a loud log.
PAYLOAD_ADMIN_EMAIL=admin@softwarefactory.local
PAYLOAD_ADMIN_PASSWORD=
